검색(select)
select 필드1, 필드2, ... FROM 테이블명 WHERE 조건
select * from std;

select id, name from std;

select * from std order by name asc;  -- desc

select * from std where idx > 10 order by id desc;
select * from std where name like '김%';

수정(갱신, update)
update 테이블명 set 필드1='값1', 필드2='값2' 
    WEHRE idx='누구'

update std set name='이순신1' where idx='1';


삭제: 

DELETE FROM 테이블명 where 조건

delete from std where idx='1';

http://localhost/phpmyadmin

list.php파일을 만들고싶어.
index.php?cmd=list와 같이 접속하면
cmd값을 보고 index.php에서 include "$cmd.php"처럼
사용되고 있어.
이미 index.php에서 DB접속후 결과를 $conn = connectDB();로
접속정보까지 확인한 상태야.
index.php에서는 HTML5와 Boostrap5로 설정이 다 된 상태야.
list.php에서는 std 테이블에서 전체 목록을 이름의 오름차순으로 가져와서
표 형태로 출력하고 싶은거야.
mysqli_fetch_array()를 이용해서 데이터를 출력하는 코드만 
있으면 돼.

이 코드를 수정하고 싶어.
표 위에 데이터를 새로 등록하는 입력창을 만들고 싶어.
name, id, birth, memo 만 입력받으면 돼.
등록버튼을 클릭하면 std 테이블에 추가한 후, 
아래 목록에도 반영되었으면 해.
목록의 맨 오른쪽에는 "비고" 항목을 만들고,
각 라인별로, 수정, 삭제 버튼을 만들어 줘.
삭제버튼을 클릭하면 반드시 "정말 삭제하시겠습니까?"와 같이
사용자에게 꼭 묻고 나서 실행해야해.
수정버튼을 누르면
등록할 때 사용했던 입력 창을 활용해서 "수정 기능"을 만들어 줘.

이 코드는 index.php?cmd=dbtest로 호출할 거고,
dbtest.php만 만들어 주면 돼.


$text = "동해물과 백두산이 마르고 닳도록..";


이번에는 같은 방법으로 ngram.php 파일을 만들거야.

상단에 textarea로 $text 항목이 있어.
옆에 분석 버튼이 있어.

분석을 클릭하면
띄어 단위로 1-gram, 2-gram, 3-gram을 분석할거야.
그런데, 한글/영어/한자만 분석할거야.
그러니까 문장기호(,.!? 등)는 분석에서 제거하면 돼.

화면 하단에 표 형태로 출력해 줘.
표의 열정보는 다음과 같아.
순서, 1음절, 빈도, 2음절, 빈도, 3음절, 빈도
상위 30개만 하고 싶어.


drop table fee;


CREATE TABLE fee (
    idx INT NOT NULL AUTO_INCREMENT,
    base_year YEAR NOT NULL COMMENT '기준연도',
    province_name VARCHAR(50) NOT NULL COMMENT '시도명',
    university_name VARCHAR(100) NOT NULL COMMENT '대학교명',
    establishment_type VARCHAR(20) NOT NULL COMMENT '설립형태구분명',
    average_tuition float default '0.0' COMMENT '평균등록금액',
    
    PRIMARY KEY (idx)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;



