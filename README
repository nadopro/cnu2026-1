mysql table을 다음과 같이 만들고 싶어.
table name : std 
idx : 자동 증가, primary key
name, id, birth, memo, time 정보가 필요해

birth : 2000-01-01 형식
id : 학생의 학번을 저장하는 용도, 예: 202412345 와 같은 형식
id : 중복이 불가능
time : 데이터가 등록되는 시간(datetime)
memo : 1만자 이상의 설명이 들어갈 수 있음.


CREATE TABLE std (
    idx INT AUTO_INCREMENT PRIMARY KEY,
    
    name VARCHAR(100) NOT NULL,
    
    id CHAR(9) NOT NULL UNIQUE,
    -- 예: 202412345
    
    birth DATE NOT NULL,
    -- 형식: 2000-01-01
    
    memo LONGTEXT,
    -- 1만자 이상 저장 가능
    
    time DATETIME DEFAULT CURRENT_TIMESTAMP
    -- 데이터 등록 시간 자동 저장
);


이 테이블에 데이터 30개를 넣고 싶어.
name : 조선시대 역사 인물중 무작위 결정
id : 2020xxxxx - 2026xxxxx 사이의 무작위 값
birth : 2000-01-01 ~ 2025-12-31 사이의 무작위 값
memo : name, id, birth를 순서대로 입력
time : 현재 시간

이를 만족하는 질의(query, 쿼리)를 만들어줘.

INSERT INTO std (name, id, birth, memo, time)
SELECT name, id, birth, CONCAT(name, ', ', id, ', ', birth), NOW()
FROM (
    SELECT '이순신' AS name, '202012345' AS id, '2001-03-15' AS birth
    UNION ALL SELECT '세종대왕', '202112346', '2002-07-21'
    UNION ALL SELECT '정약용', '202212347', '2003-11-09'
